# Deliverables are private content. The repo ships ONLY the synthetic example doc;
# any real doc you upload/drop into docs/ stays out of git.
docs/*
!docs/example.html
!docs/example.config.json
!docs/assets/
docs/assets/*
!docs/assets/.gitkeep
# Storyboard screenshots for the README are synthetic UI captures (no real
# content) — ship them so the README renders.
!docs/screenshots/
docs/screenshots/*
!docs/screenshots/*.png
# Demo GIF for the README (synthetic showcase doc, no real content).
!docs/demo.gif

# Local screen-recording demo scripts (throwaway, never shipped)
.demo/
